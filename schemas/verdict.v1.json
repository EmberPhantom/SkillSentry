  "additionalProperties": false,
  "description": "Verdict JSON Contract v1 (FROZEN).\n\n``skillId`` / ``scanId`` are additive fields agreed before the M0 freeze so\n``GET /skills/{skill_id}`` is addressable for folder-of-skills scans.",
  "properties": {
    "activeDefense": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActiveDefense"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cached": {
      "title": "Cached",
      "type": "boolean"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "riskScore": {
      "maximum": 100,
      "minimum": 0,
      "title": "Riskscore",
      "type": "integer"
    },
    "scanDurationMs": {
      "minimum": 0,
      "title": "Scandurationms",
      "type": "integer"
    },
    "scanId": {
      "format": "uuid",
      "title": "Scanid",
      "type": "string"
    },
    "skill": {
      "title": "Skill",
      "type": "string"
    },
    "skillId": {
      "format": "uuid",
      "title": "Skillid",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/VerdictTier"
    }
